# Supabase Credentials & Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Database Connection (used for migrations and direct queries)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_API_KEY=your-secure-admin-api-key-here

# Storage Buckets
STORAGE_IMAGE_BUCKET=citizen-images
STORAGE_AUDIO_BUCKET=citizen-audio

# Google Gemini API Key (Multimodal AI Intelligence)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Phase 5: Request Intelligence Configuration
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768
DUPLICATE_SIMILARITY_THRESHOLD=0.90
SIMILARITY_THRESHOLD=0.75
TOP_K_SIMILAR_REQUESTS=10
CLUSTER_EPS=0.35
CLUSTER_MIN_SAMPLES=2

